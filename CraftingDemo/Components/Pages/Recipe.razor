@page "/"
@rendermode InteractiveServer
@inject IRecipeRepository Recipes
@inject IConfiguration Configuration
@inject ILogger<Recipe> Logger

<PageTitle>@(breakdown?.RecipeName ?? GameName) – CraftingDemo</PageTitle>

<header class="recipe-header">
    <div>
        <p class="game-name">@GameName</p>
        <h1>@(breakdown?.RecipeName ?? "Choose an item to craft")</h1>
    </div>

    @if (breakdown is not null)
    {
        <div class="quantity">
            <label for="quantity">Quantity</label>
            <div class="stepper">
                <button type="button" aria-label="Decrease quantity"
                        disabled="@(quantity <= MinQuantity)"
                        @onclick="() => SetQuantityAsync(quantity - 1)">−</button>
                <input id="quantity" type="number" inputmode="numeric"
                       min="@MinQuantity" max="@MaxQuantity"
                       @bind:get="quantity" @bind:set="SetQuantityAsync" />
                <button type="button" aria-label="Increase quantity"
                        disabled="@(quantity >= MaxQuantity)"
                        @onclick="() => SetQuantityAsync(quantity + 1)">+</button>
            </div>
        </div>
    }
</header>

<section class="panel panel-picker" aria-labelledby="search-heading">
    <h2 id="search-heading">Find an item</h2>
    <div class="search">
        <input type="search" aria-label="Item name" placeholder="e.g. sword" maxlength="100"
               @bind="searchText" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
        <button type="button" @onclick="SearchAsync">Search</button>
    </div>

    @if (searchFailed)
    {
        <p class="message">The search could not be completed. Please try again later.</p>
    }
    else if (searched && results.Count == 0)
    {
        <p class="message">No craftable items match “@lastSearch”.</p>
    }
    else
    {
        <ul class="results">
            @foreach (var recipe in results)
            {
                <li>
                    <label class="result">
                        <input type="radio" name="recipe" value="@recipe.RecipeId"
                               checked="@(recipe.RecipeId == selectedRecipeId)"
                               @onchange="() => SelectAsync(recipe.RecipeId)" />
                        <span>@recipe.Name</span>
                    </label>
                </li>
            }
        </ul>
    }
</section>

@if (breakdown is not null)
{
    <div class="panels">
        <section class="panel panel-gaming" aria-labelledby="ingredients-heading">
            <h2 id="ingredients-heading">Ingredients</h2>
            <ul class="rows leveled">
                @foreach (var row in breakdown.Ingredients)
                {
                    <li class="row @LevelClass(row.Level)" style="--level: @row.Level">
                        <span class="item-name">
                            @row.ItemName
                            @if (row.IsBaseMaterial)
                            {
                                <span class="tag">base</span>
                            }
                        </span>
                        <span class="item-quantity">× @row.Quantity.ToString("N0")</span>
                    </li>
                }
            </ul>
        </section>

        <section class="panel panel-music" aria-labelledby="totals-heading">
            <h2 id="totals-heading">Base material totals</h2>
            <ul class="rows striped">
                @foreach (var total in breakdown.BaseMaterials)
                {
                    <li class="row">
                        <span class="item-name">@total.ItemName</span>
                        <span class="item-quantity">× @total.Quantity.ToString("N0")</span>
                    </li>
                }
            </ul>
        </section>
    </div>
}
else if (selectedRecipeId is not null)
{
    <p class="status">@StatusMessage</p>
}

@code {
    private const int MinQuantity = 1;
    private const int MaxQuantity = 999;

    // Backgrounds alternate by level parity; see Recipe.razor.css.
    private static string LevelClass(int level) =>
        (level == 0 ? "level-0 " : "") + (level % 2 == 0 ? "level-even" : "level-odd");

    private string GameName => Configuration["Game:DisplayName"] ?? "";

    // Search
    private string searchText = "";
    private string lastSearch = "";
    private IReadOnlyList<RecipeSummary> results = [];
    private bool searched;
    private bool searchFailed;

    // Selected recipe
    private int? selectedRecipeId;
    private RecipeBreakdown? breakdown;
    private bool loaded;
    private bool loadFailed;
    private int quantity = MinQuantity;

    private string StatusMessage =>
        loadFailed ? "The recipe could not be loaded. Please try again later."
        : loaded ? "Recipe not found."
        : "Loading recipe…";

    // Start with the full list (an empty search) so there is something to pick.
    protected override Task OnInitializedAsync() => SearchAsync();

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchAsync();
        }
    }

    private async Task SearchAsync()
    {
        try
        {
            results = await Recipes.SearchRecipesAsync(searchText);
            searchFailed = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to search recipes");
            results = [];
            searchFailed = true;
        }

        lastSearch = searchText.Trim();
        searched = true;
    }

    private Task SelectAsync(int recipeId)
    {
        selectedRecipeId = recipeId;
        loaded = false;
        return LoadAsync();
    }

    private Task SetQuantityAsync(int value)
    {
        quantity = Math.Clamp(value, MinQuantity, MaxQuantity);
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (selectedRecipeId is not int recipeId)
        {
            return;
        }

        try
        {
            breakdown = await Recipes.GetRecipeBreakdownAsync(recipeId, quantity);
            loadFailed = false;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load recipe breakdown");
            breakdown = null;
            loadFailed = true;
        }

        loaded = true;
    }
}
